package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "CarrierConfig",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    privileged: true,
    required: ["privapp_whitelist_com.android.carrierconfig"],
    aaptflags: ["--keep-raw-values"],
    static_libs: [
        "androidx.annotation_annotation",
        "carrier_config_flags_lib",
    ],
}

java_aconfig_library {
    name: "carrier_config_flags_lib",
    aconfig_declarations: "carrier_config_flags",
}

aconfig_declarations {
    name: "carrier_config_flags",
    package: "com.android.internal.carrierconfig.flags",
    container: "system_ext",
    srcs: [
        "carrierconfig.aconfig",
    ],
}
